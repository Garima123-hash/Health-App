PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/caresphere
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes-long

# Optional administrator account. Set both values, or leave both blank.
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEFAULT_HOSPITAL_NAME=CareSphere Community Hospital
ADMIN_HOSPITAL_NAME=CareSphere Community Hospital

# Copy to .env and set a long random session secret.
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-this-with-a-long-random-secret-before-running
# Optional admin account: fill BOTH values to enable an admin account. Password must be 12+ chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional names used for the default patient hospital and seeded administrator workspace.
DEFAULT_HOSPITAL_NAME=CareSphere Community Hospital
ADMIN_HOSPITAL_NAME=CareSphere Community Hospital

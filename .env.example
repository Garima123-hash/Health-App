PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-this-with-a-long-random-secret-before-running
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes-long

# Optional administrator account. Set both values, or leave both blank.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_HOSPITAL=CareSphere Central Hospital
ADMIN_HOSPITAL_NAME=CareSphere Central Hospital
DEFAULT_HOSPITAL_NAME=CareSphere Central Hospital

# MongoDB Connection (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/caresphere
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Required for Groq-powered PDF report explanations. Keep this key on the backend only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
